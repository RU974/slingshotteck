{
  "name": "slingshot-growth",
  "version": "2.0.0",
  "private": true,
  "description": "Slingshotteck website: React + Vite, pre-rendered to a fully static site (no backend)",
  "author": "Slingshotteck",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/themeGenerator.js && concurrently -k -n theme,vite \"node scripts/themeGenerator.js --watch\" \"vite\"",
    "build": "node scripts/themeGenerator.js && npm run build:client && npm run build:ssr && node scripts/prerender.mjs && node scripts/generateWebp.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier -w ./src ./plugins ./scripts"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "sharp": "^0.35.2",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.3",
    "prettier": "^3.8.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  }
}
