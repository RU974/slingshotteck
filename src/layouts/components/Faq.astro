---
import Accordion from "./Accordion.astro";
import { getListPage } from "@/lib/contentParser.astro";
import type { FaqSection } from "@/types";

import { plainify } from "@/lib/utils/textConverter";

interface Props {
  title?: string;
  description?: string;
  items?: { question: string; answer: string }[];
  schema?: boolean;
}
const props = Astro.props;
const faqEntry = await getListPage("faqSection", "faq");
const base: FaqSection = faqEntry.data;
if (!base.enable && !props.items) return;
const faqData: FaqSection = {
  ...base,
  title: props.title ?? base.title,
  description: props.description ?? base.description,
  items: props.items ?? base.items,
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqData.items.map((item) => ({
    "@type": "Question",
    name: plainify(item.question),
    acceptedAnswer: { "@type": "Answer", text: plainify(item.answer) },
  })),
};
---

<section class="section" id="faq">
  {props.schema !== false && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
  <div class="container">
    <div class="section-container grid lg:grid-cols-2">
      <div class="section-intro max-lg:text-center">
        <div class="sticky top-(--header-height)">
          <h2 class="title lg:ml-0" set:html={faqData.title} />
          <p class="subtitle lg:ml-0">{faqData.description}</p>
          {
            faqData.button && faqData.button.enable && faqData.button.link && (
              <a href={faqData.button.link} class="btn btn-outline mt-9">
                {faqData.button.label}
              </a>
            )
          }
        </div>
      </div>
      <div class="section-content">
        <div class="space-y-4">
          {
            faqData.items.map((item) => (
              <Accordion title={item.question} content={item.answer} />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
