---
interface Props {
  image?: string;
  number: string;
  title: string;
  content: string;
}
const { number, title, content } = Astro.props;

// Stroke icons (24x24 grid), keyed by step number
const icons: Record<string, string> = {
  "01": `<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M8.5 11h5M11 8.5v5" opacity=".6"/>`,
  "02": `<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.6 7.6"/><circle cx="11" cy="11" r="2"/>`,
  "03": `<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/><path d="m14 4-4 16" opacity=".7"/>`,
  "04": `<path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22 22 0 0 1-4 2z"/><path d="M9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0"/><path d="M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5"/>`,
  "05": `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
};
const icon = icons[number] ?? icons["01"];
const idx = parseInt(number, 10) - 1;
---

<div
  class="bn-card group p-8 xl:px-32 xl:py-3 relative"
  data-bn-card={number}
  style={`--i:${idx}; --w:${100 - idx * 3}%;`}
>
  <div
    class="bn-inner flex items-center flex-col lg:flex-row lg:justify-between gap-6"
  >
    <div class="bn-icon-wrap shrink-0">
      <span class="bn-ring"></span>
      <div class="bn-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icon}
        />
      </div>
    </div>

    <div class="relative grid place-items-center lg:w-56">
      <div
        class="bn-number text-[5rem] lg:text-[100px] font-extrabold t-stroke text-transparent leading-none"
      >
        {number}
      </div>
      <h3 class="text-h5-sm font-bold absolute">{title}</h3>
    </div>

    <p class="bn-text lg:w-72 text-sm text-center lg:text-left">{content}</p>
  </div>

  <div class="absolute inset-0 size-full -z-10">
    <div
      class="bn-bg border border-border size-full rounded-4xl bg-primary/5 corner-squircle"
      style="transform: perspective(100px) rotateX(-2deg);"
    >
    </div>
  </div>
</div>

<style>
  /* Scroll reveal (activated by BusinessNeeds script; visible by default without JS) */
  :global(.js) .bn-card {
    opacity: 0;
    transform: translateY(40px) scale(0.96);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i) * 120ms);
  }
  :global(.js) .bn-card.is-visible {
    opacity: 1;
    transform: none;
  }

  .bn-bg {
    transition:
      background-color 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
    position: relative;
    overflow: hidden;
  }
  /* sweeping shine */
  .bn-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgb(255 255 255 / 0.07) 50%,
      transparent 60%
    );
    transform: translateX(-120%);
  }
  .bn-card:hover .bn-bg {
    border-color: color-mix(in oklab, var(--color-primary, #3b82f6) 60%, transparent);
    background-color: color-mix(in oklab, var(--color-primary, #3b82f6) 10%, transparent);
    box-shadow: 0 0 40px -8px color-mix(in oklab, var(--color-primary, #3b82f6) 45%, transparent);
  }
  .bn-card:hover .bn-bg::after {
    transform: translateX(120%);
    transition: transform 1s ease;
  }
  .bn-card:hover .bn-inner {
    transform: translateY(-2px);
  }
  .bn-inner {
    transition: transform 0.4s ease;
  }

  /* Icon */
  .bn-icon-wrap {
    position: relative;
    width: 84px;
    height: 84px;
    display: grid;
    place-items: center;
  }
  .bn-icon {
    width: 64px;
    height: 64px;
    border-radius: 20px;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(
      145deg,
      var(--color-primary, #3b82f6),
      color-mix(in oklab, var(--color-primary, #3b82f6) 40%, #0b1220)
    );
    box-shadow:
      0 8px 24px -6px color-mix(in oklab, var(--color-primary, #3b82f6) 60%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.25);
    animation: bn-float 4.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.8s);
    transition: transform 0.4s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .bn-icon svg {
    width: 30px;
    height: 30px;
  }
  .bn-card:hover .bn-icon {
    transform: scale(1.12) rotate(-6deg);
    animation-play-state: paused;
  }
  .bn-ring {
    position: absolute;
    inset: 0;
    border-radius: 26px;
    border: 1px solid color-mix(in oklab, var(--color-primary, #3b82f6) 60%, transparent);
    animation: bn-pulse 3s ease-out infinite;
    animation-delay: calc(var(--i) * -0.6s);
  }

  /* Number */
  .bn-number {
    transition:
      transform 0.5s,
      opacity 0.5s;
  }
  .bn-card:hover .bn-number {
    transform: scale(1.08);
  }

  .bn-text {
    color: rgb(255 255 255 / 0.75);
  }

  @keyframes bn-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -6px;
    }
  }
  @keyframes bn-pulse {
    0% {
      transform: scale(0.85);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.25);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .bn-card {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .bn-icon,
    .bn-ring {
      animation: none;
    }
  }
</style>
