---
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import Badge from "@/layouts/components/Badge.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Faq from "@/layouts/components/Faq.astro";
import GradientBlob from "@/layouts/components/GradientBlob.astro";
import ImageMod from "@/layouts/components/ImageMod.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { Hrms } from "@/types";

const hrms = await getListPage("hrms", "-index");
const hrmsData: Hrms = hrms.data;
---

<Base {...hrmsData}>
  <!-- Banner -->
  <section class="section-ph relative overflow-hidden pb-20">
    <div class="container relative">
      <div class="absolute top-0 left-0 w-full">
        <div class="h-100 w-full overflow-hidden -translate-y-10">
          <canvas class="heroSporeCanvas w-full"></canvas>
        </div>
      </div>
      <div class="row justify-center">
        <div class="mb-20 text-center relative">
          <h1
            class="mb-8 lg:col-9 mx-auto text-h3 lg:text-h1 hasHighlight"
            set:html={markdownify(hrmsData.banner.title)}
          />
          <p class="mb-10 lg:col-6 mx-auto text-lg">
            {hrmsData.banner.content}
          </p>
          <div class="flex gap-4 justify-center items-center flex-wrap">
            <a
              class="btn btn-primary"
              href={hrmsData.banner.button_primary.link}
              >{hrmsData.banner.button_primary.label}</a
            >
            <a
              class="btn btn-outline"
              href={hrmsData.banner.button_secondary.link}
              >{hrmsData.banner.button_secondary.label}</a
            >
          </div>
        </div>
        <div class="col-12">
          <ImageMod
            src={hrmsData.banner.image}
            alt="Slingshotteck HRMS Sign In"
            class="w-full"
          />
        </div>
      </div>
    </div>
    <div
      class="absolute left-1/2 top-0 -translate-y-1/2 -translate-x-1/2 size-160 xl:size-300 -z-20 blur-2xl"
      style="background: radial-gradient(circle, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 78%, transparent) 20%, transparent 70%);"
    >
    </div>
  </section>
  <hr
    class="h-px bg-linear-to-r from-transparent from-10% via-white/50 to-90% to-transparent border-0"
  />

  <!-- Product Tour (real screenshots) -->
  {
    hrmsData.product_tour?.enable && (
      <section class="section-sm relative isolate overflow-hidden">
        <div class="container">
          <div class="section-intro centralize mb-16">
            <Badge title={hrmsData.product_tour.badge} />
            <h2
              class="title hasHighlight"
              set:html={markdownify(hrmsData.product_tour.title)}
            />
            {hrmsData.product_tour.content && (
              <p class="mt-4 text-text lg:col-6 mx-auto">
                {hrmsData.product_tour.content}
              </p>
            )}
          </div>

          <div class="flex flex-col gap-16 lg:gap-24">
            {hrmsData.product_tour.items.map((item: any) => (
              <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                <div class={item.reverse ? "lg:order-1" : ""}>
                  <h3 class="text-h4-sm lg:text-h3 font-bold text-white mb-4">
                    {item.title}
                  </h3>
                  <p class="text-text mb-6 leading-relaxed">{item.content}</p>
                  {item.list && (
                    <ul class="flex flex-col gap-3">
                      {item.list.map((point: string) => (
                        <li class="flex items-start gap-3">
                          <span class="mt-1 size-5 shrink-0 rounded-full bg-primary/15 grid place-items-center">
                            <DynamicIcon
                              icon="FaCheck"
                              className="text-primary text-[10px]"
                            />
                          </span>
                          <span class="text-text-light">{point}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <div class={item.reverse ? "lg:order-0" : ""}>
                  <div class="rounded-2xl border border-border/50 bg-light/6 p-2 shadow-2xl">
                    <ImageMod
                      src={item.image}
                      alt={item.title}
                      class="w-full rounded-xl object-cover"
                    />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <GradientBlob />
      </section>
    )
  }

  <!-- FAQ -->
  <Faq />

  <!-- Call to Action -->
  <CallToAction />
</Base>
