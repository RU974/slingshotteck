---
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import Badge from "@/layouts/components/Badge.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Faq from "@/layouts/components/Faq.astro";
import GradientBlob from "@/layouts/components/GradientBlob.astro";
import ImageMod from "@/layouts/components/ImageMod.astro";
import ShowcaseCard from "@/layouts/components/ShowcaseCard.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { Crm } from "@/types";

const crm = await getListPage("crm", "-index");
const crmData: Crm = crm.data;
---

<Base {...crmData}>
  <!-- Banner -->
  <section class="section-ph relative overflow-hidden pb-20">
    <div class="container relative">
      <div class="absolute top-0 left-0 w-full">
        <div class="h-100 w-full overflow-hidden -translate-y-10">
          <canvas class="heroSporeCanvas w-full"></canvas>
        </div>
      </div>
      <div class="row justify-center">
        <div class="mb-20 text-center relative">
          <h1
            class="mb-8 lg:col-9 mx-auto text-h3 lg:text-h1 hasHighlight"
            set:html={markdownify(crmData.banner.title)}
          />
          <p class="mb-10 lg:col-6 mx-auto text-lg">
            {crmData.banner.content}
          </p>
          <div class="flex gap-4 justify-center items-center flex-wrap">
            <a
              class="btn btn-primary"
              href={crmData.banner.button_primary.link}
              >{crmData.banner.button_primary.label}</a
            >
          </div>
        </div>
        <div class="col-12">
          <ImageMod
            src={crmData.banner.image}
            alt="Slingshotteck CRM Dashboard"
            class="w-full"
          />
        </div>
      </div>
    </div>
    <div
      class="absolute left-1/2 top-0 -translate-y-1/2 -translate-x-1/2 size-160 xl:size-300 -z-20 blur-2xl"
      style="background: radial-gradient(circle, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 78%, transparent) 20%, transparent 70%);"
    >
    </div>
  </section>
  <hr
    class="h-px bg-linear-to-r from-transparent from-10% via-white/50 to-90% to-transparent border-0"
  />

  <!-- Smart Platform Cards -->
  {
    crmData.smart_platform.enable && (
      <section class="section mx-5 relative isolate overflow-hidden">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize">
              <h2
                class="title hasHighlight"
                set:html={markdownify(crmData.smart_platform.title)}
              />
            </div>
            <div class="section-content">
              <div class="grid md:grid-cols-2 xl:grid-cols-3 grid-flow-dense gap-7">
                {crmData.smart_platform.cards.map((card: any) => (
                  <ShowcaseCard
                    title={card.title}
                    subtitle={card.subtitle}
                    image={card.image}
                    classNames={card.classNames}
                  />
                ))}
              </div>
            </div>
          </div>
        </div>
        <GradientBlob />
      </section>
    )
  }

  <!-- Product Tour (real screenshots) -->
  {
    crmData.product_tour?.enable && (
      <section class="section-sm relative isolate overflow-hidden">
        <div class="container">
          <div class="section-intro centralize mb-16">
            <Badge title={crmData.product_tour.badge} />
            <h2
              class="title hasHighlight"
              set:html={markdownify(crmData.product_tour.title)}
            />
            {crmData.product_tour.content && (
              <p class="mt-4 text-text lg:col-6 mx-auto">
                {crmData.product_tour.content}
              </p>
            )}
          </div>

          <div class="flex flex-col gap-16 lg:gap-24">
            {crmData.product_tour.items.map((item: any) => (
              <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                <div class={item.reverse ? "lg:order-1" : ""}>
                  <h3 class="text-h4-sm lg:text-h3 font-bold text-white mb-4">
                    {item.title}
                  </h3>
                  <p class="text-text mb-6 leading-relaxed">{item.content}</p>
                  {item.list && (
                    <ul class="flex flex-col gap-3">
                      {item.list.map((point: string) => (
                        <li class="flex items-start gap-3">
                          <span class="mt-1 size-5 shrink-0 rounded-full bg-primary/15 grid place-items-center">
                            <DynamicIcon
                              icon="FaCheck"
                              className="text-primary text-[10px]"
                            />
                          </span>
                          <span class="text-text-light">{point}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <div class={item.reverse ? "lg:order-0" : ""}>
                  <div class="rounded-2xl border border-border/50 bg-light/6 p-2 shadow-2xl">
                    <ImageMod
                      src={item.image}
                      alt={item.title}
                      class="w-full rounded-xl object-cover"
                    />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <GradientBlob />
      </section>
    )
  }

  <!-- Service Features (alternating) -->
  {
    crmData.service_features.enable &&
      crmData.service_features.items.map((feature: any, index: number) => (
        <section
          class={
            index === 0
              ? "section-sm relative isolate"
              : "section-sm relative isolate"
          }
        >
          <div class="container">
            <div class="rounded-3xl bg-light/6 overflow-hidden">
              <div class="grid lg:grid-cols-2">
                <div
                  class={`p-8 lg:p-12 xl:p-14 ${feature.reverse ? "" : "lg:order-1"}`}
                >
                  <h2
                    class="text-h3-sm lg:text-h2 font-bold hasHighlight mb-9 lg:mb-12"
                    set:html={markdownify(feature.title)}
                  />

                  <div class="grid sm:grid-cols-2 gap-8 lg:gap-10">
                    {feature.items.map((item: any) => (
                      <article>
                        <div class="size-10 rounded-xl bg-white/6 border border-border grid place-items-center mb-4">
                          <DynamicIcon
                            icon={item.icon}
                            className="text-text-light text-lg"
                          />
                        </div>
                        <h3 class="text-h5-sm font-bold text-white mb-2">
                          {item.title}
                        </h3>
                        <p class="text-text">{item.content}</p>
                      </article>
                    ))}
                  </div>
                </div>

                <div
                  class={`p-8 lg:p-12 xl:p-14 bg-white/2 h-max ${feature.reverse ? "" : "lg:order-0"}`}
                >
                  <ImageMod
                    src={feature.image}
                    alt={feature.title}
                    class="w-full object-contain"
                  />
                </div>
              </div>
            </div>
          </div>
          <GradientBlob />
        </section>
      ))
  }

  <!-- FAQ -->
  <Faq />

  <!-- Call to Action -->
  <CallToAction />
</Base>
