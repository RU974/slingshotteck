---
import config from "@/config/config.json";
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Faq from "@/layouts/components/Faq.astro";
import GradientBlob from "@/layouts/components/GradientBlob.astro";
import PageHeader from "@/layouts/components/PageHeader.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

export async function getStaticPaths() {
  const services = await getSinglePage("services");
  return services.map((service) => ({
    params: { single: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const data = service.data;
const { Content } = await render(service);

const allServices = await getSinglePage("services");
const related = allServices
  .filter((s) => data.related.includes(s.id))
  .sort((a, b) => a.data.order - b.data.order);

const siteUrl = config.site.base_url.replace(/\/$/, "");
const pageUrl = `${siteUrl}/services/${service.id}`;
const serviceSchema = {
  "@type": "Service",
  "@id": `${pageUrl}#service`,
  name: data.title,
  serviceType: data.service_type,
  description: data.description,
  url: pageUrl,
  provider: { "@id": `${siteUrl}/#organization` },
  areaServed: [
    { "@type": "Country", name: "United Kingdom" },
    { "@type": "Country", name: "United States" },
    { "@type": "Country", name: "Pakistan" },
    { "@type": "Place", name: "Worldwide" },
  ],
  hasOfferCatalog: data.deliverables.length
    ? {
        "@type": "OfferCatalog",
        name: `${data.title} services`,
        itemListElement: data.deliverables.map((d) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: d.title, description: d.content },
        })),
      }
    : undefined,
};
---

<Base
  {...data}
  schema={serviceSchema}
  breadcrumbs={[
    { name: "Services", url: "/services" },
    { name: data.title, url: `/services/${service.id}` },
  ]}
>
  <PageHeader title={markdownify(data.h1) as string} subtitle={data.intro} />

  <!-- Highlights + CTA -->
  <section class="section-sm pt-0">
    <div class="container">
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        {
          data.highlights.map((h) => (
            <span class="bg-body border border-border px-4 py-2 rounded-full text-white font-medium">
              {h}
            </span>
          ))
        }
      </div>
      <div class="flex gap-4 justify-center flex-wrap">
        <a class="btn btn-primary" href="/contact">Get a Free Consultation</a>
        <a class="btn btn-outline" href="#faq">Read the FAQ</a>
      </div>
    </div>
  </section>

  <!-- What's included -->
  {
    data.deliverables.length > 0 && (
      <section class="section relative overflow-hidden">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize" data-eyebrow="What's included">
              <h2 class="title hasHighlight">
                What's included in <strong>{data.title}</strong>
              </h2>
            </div>
            <div class="section-content">
              <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
                {data.deliverables.map((d) => (
                  <div class="bento-card p-8 rounded-3xl bg-white/5 border border-border">
                    <h3 class="text-h6 font-bold text-white">{d.title}</h3>
                    <p class="mt-3 text-text-dark">{d.content}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <GradientBlob />
      </section>
    )
  }

  <!-- Long-form content -->
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10 xl:col-8">
          <article class="content">
            <Content />
          </article>
        </div>
      </div>
    </div>
  </section>

  {
    data.faqs.length > 0 && (
      <Faq
        title={`${data.title}: frequently asked questions`}
        description={`Straight answers about Slingshotteck ${data.title.toLowerCase()} for businesses in the UK, USA, Pakistan and worldwide.`}
        items={data.faqs}
      />
    )
  }

  <!-- Related services (internal linking) -->
  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-intro centralize" data-eyebrow="Related services">
            <h2 class="title">Often combined with</h2>
          </div>
          <div class="grid md:grid-cols-3 gap-4 mt-10">
            {related.map((r) => (
              <a
                href={`/services/${r.id}`}
                class="bento-card block p-8 rounded-3xl bg-white/5 border border-border hover:border-primary transition-colors"
              >
                <DynamicIcon icon={r.data.icon} className="text-3xl text-primary" />
                <h3 class="mt-4 text-h6 font-bold text-white">{r.data.title}</h3>
                <p class="mt-2 text-text-dark">{r.data.short}</p>
                <span class="mt-4 inline-block text-primary font-semibold">
                  Learn more &rarr;
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CallToAction />
</Base>
