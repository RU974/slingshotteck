##### Static site routing (Apache / cPanel / LiteSpeed). Copied into dist/ by the build.
Options -MultiViews -Indexes
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  ## Bare domain -> www (same as the old Node server)
  RewriteCond %{HTTP_HOST} ^slingshotteck\.com$ [NC]
  RewriteRule ^ https://www.slingshotteck.com%{REQUEST_URI} [R=301,L]

  ## Force HTTPS (uncomment once SSL is active)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  ## Moved pages
  RewriteRule ^features/?$ /services [R=301,L]
  RewriteRule ^elements/?$ / [R=301,L]

  ## Remove trailing slashes: /about/ -> /about
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  ## /about.html -> /about (keep URLs clean)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  ## Serve the pre-generated .webp copy to browsers that accept it
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME}.webp -f
  RewriteRule ^(images/.+\.(png|jpe?g))$ /$1.webp [T=image/webp,E=webp:1,L]

  ## /about -> about.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

##### Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  <FilesMatch "\.(png|jpe?g)$">
    Header append Vary Accept
  </FilesMatch>
  <FilesMatch "\.(js|css|xml|gz|html)$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

##### Caching
<IfModule mod_headers.c>
  ## Hashed build files never change: cache forever
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico|mp4|woff2?|ttf|eot)$">
      Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(html|xml)$">
      Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
  </Else>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "now plus 1 week"
  ExpiresByType application/javascript "now plus 1 week"
  ExpiresByType text/javascript "now plus 1 week"
  ExpiresByType image/gif "now plus 1 month"
  ExpiresByType image/jpeg "now plus 1 month"
  ExpiresByType image/png "now plus 1 month"
  ExpiresByType image/webp "now plus 1 month"
  ExpiresByType image/avif "now plus 1 month"
  ExpiresByType image/svg+xml "now plus 1 month"
  ExpiresByType image/x-icon "now plus 1 month"
  ExpiresByType font/woff2 "now plus 1 month"
  ExpiresByType video/mp4 "now plus 1 month"
</IfModule>

##### Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
